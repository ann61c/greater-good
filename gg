#!/usr/bin/env python3
import argparse, json, os, re, subprocess, sys
from datetime import datetime

RULES = ("Rules: one active item at a time. When an item is over budget, park it now (commit WIP, stop its agents, "
         "`gg park <id> <note>`) and start the top-ranked queued item. Only the user extends a budget. "
         "\"Almost done\" is not a reason to continue. Parking is reversible, so do not wait for the user.")


USAGE = """[greater-good] Priority ledger for this project. You maintain it yourself; the user never runs gg.
When the user gives you work that will take over 30 minutes, runs in background agents, or is several tasks, record each as an item before starting it:
  gg add <id> "<title>" --why "<what the user gains>" --budget <2h|90m>
  gg rank <id> <id> ...     order by importance, taken from the user's own words; how close an item is to done does not count
  gg start <id>             one active item at a time
  gg park <id> "<note>"     gg done <id>     gg status     gg log
Budget is the most time the item is worth to the user. When the user states or changes priorities, run `gg rank` right away.
After adding or re-ranking, tell the user the order and budgets in one line. Only the user extends a budget (then run `gg budget <id> <dur>`)."""


def now():
    return datetime.fromisoformat(os.environ["GG_NOW"]) if "GG_NOW" in os.environ else datetime.now()


def dur(s):
    return sum(int(n) * {"h": 3600, "m": 60}[u] for n, u in re.findall(r"(\d+)([hm])", s))


def fmt(s):
    h, m = divmod(int(s) // 60, 60)
    return (f"{h}h{m:02d}m" if m else f"{h}h") if h else f"{m}m"


def path(cwd):
    r = subprocess.run(["git", "-C", cwd, "worktree", "list", "--porcelain"], capture_output=True, text=True)
    root = r.stdout.splitlines()[0].split(" ", 1)[1] if r.returncode == 0 else os.path.realpath(cwd)
    home = os.environ.get("GG_HOME", os.path.expanduser("~/.greater-good"))
    return os.path.join(home, root.replace("/", "-") + ".json")


def load(p):
    if os.path.exists(p):
        with open(p) as f:
            return json.load(f)


def save(p, led):
    os.makedirs(os.path.dirname(p), exist_ok=True)
    with open(p, "w") as f:
        json.dump(led, f, indent=2)


def elapsed(it):
    return it["spent_s"] + ((now() - datetime.fromisoformat(it["started_at"])).total_seconds() if it["status"] == "active" else 0)


def over(it):
    return it["status"] == "active" and elapsed(it) > it["budget_s"]


def live(led):
    return [i for i in led["items"] if i["status"] != "done"]


def status(led):
    items = live(led)
    if not items:
        return ""
    act = next((i for i in items if i["status"] == "active"), None)
    out = [f"[greater-good] {now():%Y-%m-%d %H:%M}"]
    for n, i in enumerate(items, 1):
        st, spent, b = i["status"].upper(), fmt(elapsed(i)), fmt(i["budget_s"])
        head = f"{st} #{i['id']} (rank {n}{f' of {len(items)}' if i is act else ''}) {i['title']}:"
        if i is act:
            line = f"{head} {spent} spent of {b} budget." + (f" OVER BUDGET by {fmt(elapsed(i) - i['budget_s'])}." if over(i) else "")
            out += [line, f"  why: {i['why']}"]
        elif i["status"] == "parked":
            out.append(f"{head} {spent} spent of {b} budget. note: {i['note']}")
        else:
            out.append(f"{head} budget {b}, {spent} spent. why: {i['why']}")
    waiting = [i for i in items if i["status"] == "queued" and i["spent_s"] == 0]
    if act:
        top = next((i for i in waiting if items.index(i) < items.index(act)), None)
        if top:
            out.append(f"WARNING: #{top['id']} outranks the active item and has not started.")
    elif items:
        out.append(f"Nothing active. Next by rank: #{next(i for i in items if i['status'] in ('queued', 'parked'))['id']}.")
    return "\n".join(out + [RULES])


def hook(a):
    d = json.load(sys.stdin)
    led = load(path(d["cwd"]))
    ev = d["hook_event_name"]
    if ev == "SessionStart":
        print(USAGE + ("\n\n" + status(led) if led and live(led) else ""))
    elif not led:
        return
    elif ev == "UserPromptSubmit":
        if live(led):
            print(status(led))
    elif ev == "Stop" and not d.get("stop_hook_active"):
        act = next((i for i in led["items"] if over(i)), None)
        if act:
            nxt = next((i for i in led["items"] if i["status"] == "queued"), None)
            go = f"`gg start {nxt['id']}` (top-ranked queued: {nxt['title']})" if nxt else "`gg start` the top-ranked queued item"
            print(json.dumps({"decision": "block", "reason":
                f"#{act['id']} {act['title']} is over budget: {fmt(elapsed(act))} spent of {fmt(act['budget_s'])}. "
                f"Commit WIP, `gg park {act['id']} <note>`, then {go}. "
                f"If the user explicitly extended the budget, run `gg budget {act['id']} <dur>` instead."}))


def main():
    p = argparse.ArgumentParser()
    s = p.add_subparsers(dest="cmd", required=True)
    for name, args in [("add", ["id", "title"]), ("rank", ["ids*"]), ("start", ["id"]), ("park", ["id", "note"]),
                       ("done", ["id"]), ("budget", ["id", "dur"]), ("status", []), ("log", []), ("hook", [])]:
        sp = s.add_parser(name)
        for x in args:
            sp.add_argument(x.rstrip("*"), nargs="*" if x.endswith("*") else None)
        if name == "add":
            sp.add_argument("--why", required=True)
            sp.add_argument("--budget", required=True)
    a = p.parse_args()
    if a.cmd == "hook":
        return hook(a)
    pth = path(os.getcwd())
    led = load(pth)
    if a.cmd in ("status", "log"):
        if led and (a.cmd == "log" or live(led)):
            print(status(led) if a.cmd == "status" else "\n".join(f"{e['at']} {e['event']} #{e['id']} {e['detail']}" for e in led["events"]))
        return
    led = led or {"items": [], "events": []}
    get = lambda i: next(x for x in led["items"] if x["id"] == i)
    detail = ""
    if a.cmd == "add":
        led["items"].append(dict(id=a.id, title=a.title, why=a.why, budget_s=dur(a.budget), status="queued", spent_s=0, started_at=None, note=""))
        detail = a.why
    elif a.cmd == "rank":
        top = [get(i) for i in a.ids]
        led["items"] = top + [i for i in led["items"] if i not in top]
        detail = " ".join(a.ids)
    elif a.cmd == "budget":
        get(a.id)["budget_s"] = dur(a.dur)
        detail = a.dur
    else:
        it = get(a.id)
        if a.cmd == "start":
            cur = next((i for i in led["items"] if i["status"] == "active"), None)
            if cur:
                sys.exit(f"#{cur['id']} is active; park or finish it first")
            it.update(status="active", started_at=now().isoformat())
        else:
            if it["status"] == "active":
                it.update(spent_s=elapsed(it), started_at=None)
            it["status"] = "parked" if a.cmd == "park" else "done"
            if a.cmd == "park":
                it["note"] = detail = a.note
    led["events"].append(dict(at=now().isoformat(timespec="seconds"), event=a.cmd, id=getattr(a, "id", None) or "", detail=detail))
    save(pth, led)


main()
